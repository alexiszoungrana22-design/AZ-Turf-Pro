// =====================================
// AZ TURF PRO - ESPACE PREMIUM
// Connexion ticket.html
// =====================================

const API_URL =
"https://az-turf-pro.onrender.com/api/analyse";



document.addEventListener(
"DOMContentLoaded",
chargerPremium
);



async function chargerPremium(){

try{


const response = await fetch(API_URL);


if(!response.ok){

throw new Errx
or("Erreur API");

}



const data = await response.json();



console.log(
"Données Premium :",
data
);



const premium
data.tickets?.vip || {};

const classement =
data.classement || [];




// ===============================
// SELECTION 7 CHEVAUX
// ===============================

const selection =
document.getElementById(
"selection-premium"
);


if(selection){


selection.innerHTML = `

<div class="ticket-grand">

${
classement
.slice(0,7)
.map(c => c.numero)
.join(" - ")
}

</div>

`;

}




// ===============================
// EXPLICATION DES CHOIX
// ===============================

const explication =
document.getElementById(
"explication-choix"
);



if(explication){


explication.innerHTML =

classement
.slice(0,7)
.map(c => `

<p>

🏇 N°${c.numero}

<br>

${c.raison || "Analyse en cours"}

</p>

`)
.join("");

}






// ===============================
// TICKETS PREMIUM
// ===============================

afficherTicket(
"vip-quinte",
vip.quinte
);



afficherTicket(
"vip-quarte",
vip.quarte
);



afficherTicket(
"vip-trio",
vip.trio
);







// ===============================
// COUPLE GAGNANT / PLACE
// FORMAT 3-5-2
// ===============================


const couple =
document.getElementById(
"couple-gagnant-place"
);



if(couple){


couple.innerHTML = `

<div class="ticket-grand">

${
classement
.slice(0,3)
.map(c=>c.numero)
.join(" - ")
}

</div>

`;

}







// ===============================
// CHAMP REDUIT
// ===============================


const champ =
document.getElementById(
"champ-reduit"
);



if(champ && vip.champ_reduit){


champ.innerHTML = `

<div class="ticket-grand">

${vip.champ_reduit.format}

</div>


<br>

Bases :
${vip.champ_reduit.bases.join("-")}


<br>

Compléments :
${vip.champ_reduit.complements.join("-")}

`;

}








// ===============================
// ANALYSE PERFORMANCE
// ===============================


const analyse =
document.getElementById(
"analyse-performance"
);



if(analyse){


analyse.innerHTML = `


<h3>📈 Bonnes performances</h3>

<p>
Étude de la forme récente, de la régularité,
du profil du cheval, de la distance et des conditions favorables.
</p>


<h3>📉 Mauvaises performances</h3>

<p>
Recherche des causes possibles :
mauvais parcours, distance, niveau d'opposition,
terrain ou circonstances de course.
</p>


`;

}








// ===============================
// DERNIERE MINUTE
// ===============================


const derniere =
document.getElementById(
"derniere-minute"
);



if(derniere && vip.ticket_derniere_minute){


derniere.innerHTML = `

<div class="ticket-grand">

${vip.ticket_derniere_minute.format}

</div>


<br>

Sélection :
${vip.ticket_derniere_minute.selection.join(" - ")}


<br>

Joker :
N°${vip.ticket_derniere_minute.joker}

`;

}








// ===============================
// MESSAGE FINAL
// ===============================


const message =
document.getElementById(
"message-fin"
);



if(message){


message.innerHTML =

vip.message_fin ||

"🍀 Bonne chance aux membres Premium !";


}





}

catch(error){


console.error(
"Erreur Premium AZ Turf :",
error
);


}

}







function afficherTicket(id, liste){


const zone =
document.getElementById(id);



if(!zone){

return;

}



if(!liste || liste.length === 0){


zone.innerHTML =
"Non disponible";


return;

}



zone.innerHTML = `

<div class="ticket-grand">

${liste.join(" - ")}

</div>

`;

}
